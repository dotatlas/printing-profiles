# API settings. The API reads them from environment variables; it never reads this file.
# When a value is not set, the API uses the dev default shown here. In prod, SITE_ORIGIN is required.

# dev or prod
ENV=dev
# The port that the API listens on
PORT=8080
# The only origin that CORS allows (it must be https in prod)
SITE_ORIGIN=http://localhost:3000
# The PostgreSQL connection URL (required in prod). The default is the docker compose database.
DATABASE_URL=postgres://printing:printing@localhost:5432/printing?sslmode=disable
# The API's own origin, for the OAuth callback URLs (required in prod, https)
API_ORIGIN=http://localhost:8080
# OAuth apps. A provider is on only when both of its values are set. In dev, the fake provider needs none.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The HMAC key for rate-limit keys (required in prod, 32+ characters, for example: openssl rand -hex 32)
HASH_KEY=
# How many proxies in front of the API add to X-Forwarded-For (default: 0 in dev, 1 in prod)
PROXY_HOPS=

# Site settings (web/). The site reads them from environment variables.
# The base URL of the API for reads on the server. Required when the site runs in production mode.
API_URL=http://localhost:8080
# The public URL of the site, for the absolute URLs in link previews. Read when the site is built, not when it runs.
SITE_URL=http://localhost:3000
