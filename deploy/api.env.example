# /etc/printing-profiles/api.env (root only, mode 600). Read by the api and migrate services.
ENV=prod
PORT=8080
# The site's origin, the only origin that CORS allows
SITE_ORIGIN=https://example.com
# The same user, password and database as db.env. "db" is the database service on the internal network.
DATABASE_URL=postgres://printing:change-me@db:5432/printing?sslmode=disable
