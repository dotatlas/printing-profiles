meta {
  name: complete an upload
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/api/v1/uploads/{{uploadId}}/complete
  body: none
  auth: none
}

headers {
  Cookie: __Host-session={{session}}
  Origin: {{siteOrigin}}
}

script:post-response {
  bru.setVar("fileUrl", res.body.file_url);
}

assert {
  res.status: eq 200
  res.body.status: eq ready
  res.body.slicer: eq prusaslicer
  res.body.kind: eq print
  res.body.removed[0]: eq printhost_password
}
