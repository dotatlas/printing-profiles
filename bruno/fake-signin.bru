meta {
  name: fake sign-in (dev only)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/auth/fake/start?login=bruno&return=/presets
  body: none
  auth: none
}

settings {
  followRedirects: false
}

script:post-response {
  // Keep the session token for the next requests. Only the dev-only fake provider gives one without a real sign-in.
  const cookies = [].concat(res.getHeader("set-cookie") || []);
  const session = cookies.find((c) => c.startsWith("__Host-session="));
  bru.setVar("session", session ? session.split(";")[0].split("=")[1] : "");
}

assert {
  res.status: eq 303
}

tests {
  test("goes back to the return path on the site", function () {
    expect(res.getHeader("location")).to.match(/\/presets$/);
  });

  test("sets a host-only, HttpOnly, Secure, Lax session cookie", function () {
    const c = [].concat(res.getHeader("set-cookie")).find((c) => c.startsWith("__Host-session="));
    expect(c).to.match(/Path=\//).and.match(/HttpOnly/).and.match(/Secure/).and.match(/SameSite=Lax/);
    expect(c).to.not.match(/Domain=/);
  });
}
