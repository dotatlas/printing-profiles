meta {
  name: ask for an upload
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/v1/uploads
  body: json
  auth: none
}

headers {
  Cookie: __Host-session={{session}}
  Origin: {{siteOrigin}}
}

body:json {
  {"kind": "preset_file", "size": 1}
}

script:pre-request {
  // A small PrusaSlicer preset with a printer password, which the check must remove.
  const text = "# generated by PrusaSlicer 2.9.6 on 2026-07-22 at 19:42:46 UTC\nlayer_height = 0.2\nprint_settings_id = \nprinthost_password = hunter2\n";
  bru.setVar("presetText", text);
  req.setBody({ kind: "preset_file", size: Buffer.byteLength(text) });
}

script:post-response {
  bru.setVar("uploadId", res.body.id);
  bru.setVar("uploadUrl", res.body.url);
}

assert {
  res.status: eq 201
  res.body.method: eq PUT
  res.body.headers["Content-Type"]: eq application/octet-stream
}
