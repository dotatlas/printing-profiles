meta {
  name: change the display name
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/me
  body: json
  auth: none
}

headers {
  Cookie: __Host-session={{session}}
  Origin: {{siteOrigin}}
}

body:json {
  {"display_name": "Bruno Tester"}
}

assert {
  res.status: eq 200
  res.body.display_name: eq Bruno Tester
}
